# =============================================================================
# Deployment packages — one build invocation targets one platform.
#
# Pass --config to select the cross-compilation toolchain:
#   x86_64-linux    Linux / x86_64   (developer workstation)
#   aarch64-linux   Linux / aarch64  (e.g. Raspberry Pi 4 + Ubuntu)
#   x86_64-qnx     QNX 8 / x86_64
#   aarch64-qnx    QNX 8 / aarch64  (e.g. Raspberry Pi 4 + QNX 8)
#
# The output archive name contains the CPU identifier from the active toolchain
# (e.g. "aarch64" for both aarch64-linux and aarch64-qnx builds).
#
# Build individual packages:
#   bazel build //deployment:gateway_tar    --config=aarch64-linux
#   bazel build //deployment:benchmarks_tar --config=aarch64-linux
#
# Build all packages for a platform in one invocation:
#   bazel build //deployment:all_tars --config=aarch64-linux
#
# Repeat with a different --config to produce packages for another platform.
# =============================================================================

load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load(":defs.bzl", "deb_architecture_file", "names_from_toolchains", "scoreipgw_pkg_tar")

names_from_toolchains(
    name = "toolchain_vars",
)

deb_architecture_file(
    name = "deb_architecture",
)

# Config files are renamed and flattened to the package root so that
# run_gateway.sh can reference them via ${SCRIPT_DIR}/<filename>.
pkg_files(
    name = "gatewayd_config_files",
    srcs = [
        "//score/config:config_file",
        "//score/gatewayd:etc/mw_com_config.json",
    ],
    renames = {
        "//score/config:config_file": "gatewayd_config.bin",
        "//score/gatewayd:etc/mw_com_config.json": "gatewayd_mw_com_config.json",
    },
)

# =============================================================================
# gateway_tar — gateway daemon package
#
# Contains: gatewayd, someipd (with Bazel runfiles), default configs, and
#           run_gateway.sh for easy startup on the target machine.
#
# The archive is named gateway_tar-<cpu>.tar.gz, where <cpu> is the CPU
# identifier resolved by the active toolchain (e.g. gateway_tar-aarch64.tar.gz
# when using --config=aarch64-linux or --config=aarch64-qnx).
#
# Deploy on the target:
#   tar xzf gateway_tar-<cpu>.tar.gz
#   export VSOMEIP_CONFIGURATION=/path/to/vsomeip.json
#   ./score_someip_gateway/gateway/run_gateway.sh gatewayd   # terminal 1
#   ./score_someip_gateway/gateway/run_gateway.sh someipd    # terminal 2
# =============================================================================

scoreipgw_pkg_tar(
    name = "gateway_tar",
    srcs = [
        "run_gateway.sh",
        ":gatewayd_config_files",
        "//score/gatewayd",
        "//score/someipd",
    ],
    package_dir = module_name() + "/gateway",
)

scoreipgw_pkg_tar(
    name = "benchmarks_tar",
    srcs = [
        "//tests/benchmarks:echo_server",
        "//tests/benchmarks:ipc_benchmarks",
    ],
    package_dir = module_name() + "/benchmarks",
)

# =============================================================================
# Convenience target
# =============================================================================

filegroup(
    name = "all_tars",
    srcs = [
        ":benchmarks_tar",
        ":gateway_tar",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Debian packaging
# =============================================================================

filegroup(
    name = "base_dependency_artifacts",
    srcs = [
        "@score_baselibs//score/containers:non_relocatable_vector",
        "@score_baselibs//score/filesystem",
        "@score_baselibs//score/language/futurecpp",
        "@score_baselibs//score/memory/shared",
        "@score_baselibs//score/mw/log",
        "@score_baselibs//score/result",
        "@score_communication//score/message_passing",
        "@score_communication//score/mw/com",
        "@vsomeip",
    ],
)

pkg_files(
    name = "s_core_base_libs",
    srcs = [":base_dependency_artifacts"],
    prefix = "usr/lib/s-core-base",
    strip_prefix = strip_prefix.files_only(),
)

pkg_filegroup(
    name = "s_core_base_pkg_files",
    srcs = [":s_core_base_libs"],
)

pkg_tar(
    name = "s_core_base_data_tar",
    srcs = [":s_core_base_pkg_files"],
    extension = "tar",
)

pkg_deb(
    name = "s_core_base_deb",
    architecture_file = ":deb_architecture",
    data = ":s_core_base_data_tar",
    description = "S-CORE base binary artifacts required by SOME/IP Gateway.",
    maintainer = "S-CORE SOME/IP Gateway Team <score@example.com>",
    package = "s-core-base",
    section = "libs",
    version = "0.1.0",
)

pkg_files(
    name = "someip_gateway_binaries",
    srcs = [
        "//score/gatewayd",
        "//score/someipd",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "usr/bin",
)

pkg_files(
    name = "someip_gateway_serializer",
    srcs = ["//score/serializer:null_serializer"],
    prefix = "usr/lib/someip-gateway",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "someip_gateway_headers",
    srcs = [
        "//score/gateway_ipc_binding:headers",
        "//score/serializer:headers",
        "//score/socom:headers",
        "//score/someip:headers",
    ],
    prefix = "usr/include/someip-gateway",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_files(
    name = "someip_gateway_config",
    srcs = [":gatewayd_config_files"],
    prefix = "etc/someip-gateway",
)

pkg_files(
    name = "someip_gateway_launcher",
    srcs = ["run_gateway.sh"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "usr/lib/someip-gateway",
    strip_prefix = strip_prefix.files_only(),
)

pkg_filegroup(
    name = "someip_gateway_pkg_files",
    srcs = [
        ":someip_gateway_binaries",
        ":someip_gateway_config",
        ":someip_gateway_headers",
        ":someip_gateway_launcher",
        ":someip_gateway_serializer",
    ],
)

pkg_tar(
    name = "someip_gateway_data_tar",
    srcs = [":someip_gateway_pkg_files"],
    extension = "tar",
)

pkg_deb(
    name = "someip_gateway_deb",
    architecture_file = ":deb_architecture",
    data = ":someip_gateway_data_tar",
    depends = ["s-core-base (>= 0.1.0)"],
    description = "SOME/IP Gateway binaries and headers.",
    maintainer = "S-CORE SOME/IP Gateway Team <score@example.com>",
    package = "someip-gateway",
    section = "net",
    version = "0.1.0",
)

filegroup(
    name = "all_debs",
    srcs = [
        ":s_core_base_deb",
        ":someip_gateway_deb",
    ],
    visibility = ["//visibility:public"],
)
